    {
      "id": "linear-approximation",
      "name": "Linear Approximation (Tangent Line)",
      "category": "calculus",
      "topic": "applications-of-derivatives",
      "latex": "L(x) = f(a) + f'(a)(x - a)",
      "plain": "L(x) = f(a) + f′(a)(x − a)",
      "description": "Approximates f near x = a using its tangent line.",
      "variables": [
        {
          "key": "fa",
          "symbol": "f(a)",
          "name": "function value at a"
        },
        {
          "key": "fpa",
          "symbol": "f'(a)",
          "name": "derivative at a"
        },
        {
          "key": "a",
          "symbol": "a",
          "name": "center point"
        },
        {
          "key": "x",
          "symbol": "x",
          "name": "nearby input"
        }
      ],
      "output": {
        "key": "L",
        "symbol": "L(x)",
        "name": "approximate value"
      },
      "compute": "fa + fpa*(x - a)",
      "conditions": [
        "f differentiable at a; accurate only for x near a"
      ],
      "examples": [
        {
          "inputs": {
            "fa": 2,
            "fpa": 0.25,
            "a": 4,
            "x": 4.1
          },
          "output": 2.025,
          "note": "√4.1 ≈ 2.025 using f(x) = √x at a = 4."
        }
      ],
      "tags": [
        "derivatives",
        "approximation",
        "tangent-line"
      ],
      "links": {
        "learn": "https://mathovia.com/math/calculus/linear-approximation/",
        "practice": "https://mathovia.com/practice/linear-approximation-practice-problems/"
      }
    },
    {
      "id": "mean-value-theorem",
      "name": "Mean Value Theorem",
      "category": "calculus",
      "topic": "applications-of-derivatives",
      "latex": "f'(c) = \\frac{f(b) - f(a)}{b - a}",
      "plain": "f′(c) = (f(b) − f(a)) / (b − a)",
      "description": "Some point c in (a, b) has an instantaneous rate equal to the average rate over [a, b]. The value computed is that required slope f′(c).",
      "variables": [
        {
          "key": "fa",
          "symbol": "f(a)",
          "name": "function value at a"
        },
        {
          "key": "fb",
          "symbol": "f(b)",
          "name": "function value at b"
        },
        {
          "key": "a",
          "symbol": "a",
          "name": "left endpoint"
        },
        {
          "key": "b",
          "symbol": "b",
          "name": "right endpoint"
        }
      ],
      "output": {
        "key": "s",
        "symbol": "f'(c)",
        "name": "required slope"
      },
      "compute": "(fb - fa) / (b - a)",
      "conditions": [
        "f continuous on [a, b] and differentiable on (a, b)"
      ],
      "examples": [
        {
          "inputs": {
            "fa": 0,
            "fb": 8,
            "a": 0,
            "b": 2
          },
          "output": 4,
          "note": "f(x) = x³ on [0, 2]; 3c² = 4 gives c = 2/√3."
        }
      ],
      "tags": [
        "mean-value-theorem",
        "derivatives",
        "theorems"
      ],
      "links": {
        "learn": "https://mathovia.com/math/calculus/mean-value-theorem/",
        "practice": "https://mathovia.com/practice/mean-value-theorem-practice-problems/"
      }
    },
    {
      "id": "chain-rule",
      "name": "Chain Rule",
      "category": "calculus",
      "topic": "derivatives",
      "latex": "\\frac{d}{dx} f(g(x)) = f'(g(x)) \\cdot g'(x)",
      "plain": "d/dx f(g(x)) = f′(g(x)) · g′(x)",
      "description": "Derivative of a composite function: outer derivative (evaluated at the inner function) times inner derivative.",
      "variables": [
        {
          "key": "fpg",
          "symbol": "f'(g(x))",
          "name": "outer derivative evaluated at g(x)"
        },
        {
          "key": "gp",
          "symbol": "g'(x)",
          "name": "inner derivative at x"
        }
      ],
      "output": {
        "key": "d",
        "symbol": "(f \\circ g)'(x)",
        "name": "derivative of the composition at x"
      },
      "compute": "fpg * gp",
      "conditions": [
        "g differentiable at x, f differentiable at g(x)"
      ],
      "examples": [
        {
          "inputs": {
            "fpg": 12,
            "gp": 2
          },
          "output": 24,
          "note": "f(u) = u³, g(x) = x² + 1 at x = 1: f′(g(1)) = 3·2² = 12 and g′(1) = 2."
        }
      ],
      "tags": [
        "derivatives",
        "differentiation-rules",
        "composition"
      ],
      "links": {
        "learn": "https://mathovia.com/math/calculus/chain-rule/",
        "practice": "https://mathovia.com/practice/chain-rule-practice-problems/"
      }
    },
