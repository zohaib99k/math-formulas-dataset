{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zohaib99k/math-formulas-dataset/schema/formula.schema.json",
  "title": "Math formula entry",
  "description": "One formula in the Math Formulas Dataset. Each data/*.json file is an array of these.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "topic", "latex", "plain", "description", "variables", "output", "compute", "examples", "tags", "links"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Unique, stable kebab-case identifier." },
      "name": { "type": "string" },
      "category": { "enum": ["algebra", "arithmetic", "calculus", "statistics", "trigonometry"] },
      "topic": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "latex": { "type": "string", "description": "LaTeX source (no surrounding $ delimiters)." },
      "plain": { "type": "string", "description": "Plain-text / Unicode rendering." },
      "description": { "type": "string", "maxLength": 280 },
      "variables": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["key", "symbol", "name"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Identifier used in `compute` and example inputs." },
            "symbol": { "type": "string", "description": "LaTeX symbol." },
            "name": { "type": "string" },
            "unit": { "type": "string" }
          }
        }
      },
      "output": {
        "type": "object",
        "required": ["key", "symbol", "name"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "symbol": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "compute": { "type": "string", "description": "JavaScript expression using variable keys and helpers (sqrt, exp, ln, log10, sin, cos, tan, atan, PI, E, fact, comb …). May return a number or an array of numbers." },
      "conditions": { "type": "array", "items": { "type": "string" } },
      "examples": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["inputs", "output"],
          "additionalProperties": false,
          "properties": {
            "inputs": { "type": "object", "additionalProperties": { "type": "number" } },
            "output": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" } }] },
            "tolerance": { "type": "number", "description": "Relative tolerance; default 1e-9." },
            "display": { "type": "string", "description": "Human-friendly form of the output, e.g. a fraction." },
            "note": { "type": "string" }
          }
        }
      },
      "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
      "links": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "learn": { "type": "string", "pattern": "^https://mathovia\\.com/.*/$" },
          "calculate": { "type": "string", "pattern": "^https://mathovia\\.com/.*/$" },
          "practice": { "type": "string", "pattern": "^https://mathovia\\.com/.*/$" }
        }
      }
    }
  }
}
